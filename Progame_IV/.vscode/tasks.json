{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Project",
      "type": "process",
      "isBuildCommand": true,
      "command": "${userHome}/.pico-sdk/ninja/v1.13.2/ninja",
      "args": [
        "-C",
        "${workspaceFolder}/build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe"
      }
    },
    {
      "label": "Build (silent)",
      "detail": "静默构建：供 Flash / Debug / Run 作为依赖使用，成功时不弹出终端面板",
      "type": "process",
      "command": "${userHome}/.pico-sdk/ninja/v1.13.2/ninja",
      "args": [
        "-C",
        "${workspaceFolder}/build"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe"
      }
    },
    {
      "label": "Flash",
      "detail": "probe-rs download (SWD) —— 供「Flash Pico Project (SWD)」按钮调用，任务名必须是 Flash",
      "type": "process",
      "command": "probe-rs",
      "args": [
        "download",
        "--chip",
        "rp2040",
        "--reset",
        "${workspaceFolder}/build/Progame_IV.elf"
      ],
      "dependsOrder": "sequence",
      "dependsOn": "Build (silent)",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run + RTT (probe-rs)",
      "type": "process",
      "command": "probe-rs",
      "args": [
        "run",
        "--chip",
        "rp2040",
        "${workspaceFolder}/build/Progame_IV.elf"
      ],
      "dependsOrder": "sequence",
      "dependsOn": "Build (silent)",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Reset Target (probe-rs)",
      "type": "process",
      "command": "probe-rs",
      "args": [
        "reset",
        "--chip",
        "rp2040"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Erase Chip (probe-rs)",
      "type": "process",
      "command": "probe-rs",
      "args": [
        "erase",
        "--chip",
        "rp2040"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Project",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build (silent)"
      ],
      "command": "${userHome}/.pico-sdk/picotool/2.3.1/picotool/picotool",
      "args": [
        "load",
        "${workspaceFolder}/build/Progame_IV.elf",
        "-fx"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.3.1/picotool/picotool.exe"
      }
    }
  ]
}