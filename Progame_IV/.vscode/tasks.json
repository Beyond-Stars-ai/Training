{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Project",
      "type": "process",
      "isBuildCommand": true,
      "command": "${userHome}/.pico-sdk/ninja/v1.13.2/ninja",
      "args": [
        "-C",
        "${workspaceFolder}/build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe"
      }
    },
    {
      "label": "Flash (probe-rs)",
      "type": "process",
      "command": "probe-rs",
      "args": [
        "download",
        "--chip",
        "${command:raspberry-pi-pico.getChip}",
        "${command:raspberry-pi-pico.launchTargetPath}"
      ],
      "dependsOrder": "sequence",
      "dependsOn": "Compile Project",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run + RTT (probe-rs)",
      "type": "process",
      "command": "probe-rs",
      "args": [
        "run",
        "--chip",
        "${command:raspberry-pi-pico.getChip}",
        "${command:raspberry-pi-pico.launchTargetPath}"
      ],
      "dependsOrder": "sequence",
      "dependsOn": "Compile Project",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Reset Target (probe-rs)",
      "type": "process",
      "command": "probe-rs",
      "args": [
        "reset",
        "--chip",
        "${command:raspberry-pi-pico.getChip}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Erase Chip (probe-rs)",
      "type": "process",
      "command": "probe-rs",
      "args": [
        "erase",
        "--chip",
        "${command:raspberry-pi-pico.getChip}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Project",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Compile Project"
      ],
      "command": "${command:raspberry-pi-pico.getPicotoolPath}",
      "args": [
        "load",
        "${command:raspberry-pi-pico.launchTargetPath}",
        "-fx"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}